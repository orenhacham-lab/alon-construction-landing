# ==========================================================
#  משתני סביבה - אלון עבודות בניה בע"מ | דף נחיתה
# ==========================================================
# העתיקו קובץ זה ל-.env.local לפיתוח מקומי,
# או הזינו את הערכים ב-Vercel > Project > Settings > Environment Variables
# ----------------------------------------------------------

# כתובת המייל אליה יישלחו הלידים מהטופס
LEADS_TO_EMAIL=alonmor101@gmail.com

# מפתח API של Resend (https://resend.com/api-keys)
# חובה כדי שהטופס ישלח מיילים בפועל. השאירו ריק והטופס יחזיר שגיאה ברורה.
RESEND_API_KEY=

# כתובת השולח. לבדיקות ניתן להשתמש ב-onboarding@resend.dev (ברירת מחדל).
# בפרודקשן יש לאמת דומיין ב-Resend ולהזין כתובת מהדומיין המאומת, למשל:
# LEADS_FROM_EMAIL=לידים <leads@alon-construction.co.il>
LEADS_FROM_EMAIL="אלון עבודות בניה <onboarding@resend.dev>"

# כתובת לקבלת עותק (BCC) של כל ליד - אופציונלי
# LEADS_BCC_EMAIL=alonmor101@gmail.com

# ---- ערכים ציבוריים (נחשפים בצד הלקוח) ----

# מזהה Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-K6JV8SB6

# כתובת האתר (לשימוש ב-SEO / sitemap / Open Graph)
NEXT_PUBLIC_SITE_URL=https://alon-construction-landing.vercel.app
